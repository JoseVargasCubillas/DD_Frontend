<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

<IfModule mod_headers.c>
  # El documento SPA siempre debe revalidarse para cargar el bundle vigente.
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Vite genera nombres versionados: estos recursos pueden almacenarse de forma inmutable.
  <If "%{REQUEST_URI} =~ m#^/assets/# && %{REQUEST_URI} !~ m#\.(mp4|webm|mov)$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Permitir range requests (streaming del video) y CORS
  <FilesMatch "\.(mp4|webm|mov)$">
    Header set Accept-Ranges "bytes"
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
